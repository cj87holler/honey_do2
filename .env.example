# Local development (Docker PostgreSQL)
DATABASE_URL=postgresql://honey_do:honey_do_local@localhost:5433/honey_do
# Production only (Neon-Vercel integration provides both automatically)
# DATABASE_URL_UNPOOLED=<direct connection string from Neon — used for migrations>

BETTER_AUTH_SECRET=generate-a-random-32-char-secret
BETTER_AUTH_URL=http://localhost:3000

# Linear personal API key — only used by `make linear-sync` (mirrors .planning/ into Linear).
# Not needed to run the app. Generate at: Linear > Settings > Security & access > Personal API keys
LINEAR_API_KEY=

# Comma-separated list of admin email addresses (case-insensitive, trimmed)
# Leave empty or unset for zero admins (safe default per D-02)
# Example: ADMIN_EMAILS=you@example.com,other@example.com
ADMIN_EMAILS=
